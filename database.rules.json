{
  "rules": {
    ".read": false,
    ".write": false,
    "mesa": {
      ".read": "auth != null",
      "mestres": {
        "$uid": {
          ".write": "auth != null && ((!root.child('mesa/mestres').exists() && $uid === auth.uid) || root.child('mesa/mestres/' + auth.uid).val() === true)",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "fichas": {
      ".read": "auth != null",
      "$id": { ".write": "auth != null && (auth.uid === $id || root.child('mesa/mestres/' + auth.uid).val() === true)" }
    },
    "live": {
      ".read": "auth != null",
      "$topic": { ".write": "auth != null && ($topic === 'roll' || root.child('mesa/mestres/' + auth.uid).val() === true)" }
    },
    "secret": {
      ".read": "auth != null && root.child('mesa/mestres/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('mesa/mestres/' + auth.uid).val() === true"
    },
    "maps":   { ".read": "auth != null", ".write": "auth != null && root.child('mesa/mestres/' + auth.uid).val() === true" },
    "tokens": { ".read": "auth != null", ".write": "auth != null && root.child('mesa/mestres/' + auth.uid).val() === true" },
    "vtt":    { ".read": "auth != null", ".write": "auth != null && root.child('mesa/mestres/' + auth.uid).val() === true" },
    "mural":  { ".read": "auth != null", ".write": "auth != null && root.child('mesa/mestres/' + auth.uid).val() === true" }
  }
}
